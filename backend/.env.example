# ============================================================
#  homelab-monitor — Configuracion del backend
#
#  INSTRUCCIONES PARA NUEVOS DESARROLLADORES:
#  1. Copia este archivo a ".env" (en la misma carpeta backend/)
#  2. Ejecuta: npm install && npm run dev
#  3. Abre http://localhost:3000/api/metrics en tu navegador
#     y veras las metricas de tus servicios.
#
#  No necesitas tocar el codigo fuente. Todo se configura
#  aqui. Si MONITOR_SERVICES esta vacio, el monitor detecta
#  automaticamente tu gateway local y monitorea los DNS
#  publicos (Cloudflare 1.1.1.1 y Google 8.8.8.8).
# ============================================================

# -----------------------------------------------------------
# Puerto del servidor HTTP (API REST)
# -----------------------------------------------------------
PORT=3000

# -----------------------------------------------------------
# Entorno de ejecucion
#   development  -> logs detallados, sin cache
#   production   -> logs menos verbosos, optimizado
#   test         -> para suites de testeo
# -----------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------
# Servicios a monitorizar
# -----------------------------------------------------------
# Formato: lista separada por comas de "nombre=url"
#   - Si omites "nombre=", se usara el hostname de la URL.
#   - Usa http:// para servidores sin TLS (p. ej. router local).
#   - Usa https:// para servidores con TLS (p. ej. DNS publicos).
#
# Ejemplo con servicios personalizados:
#   MONITOR_SERVICES=mi-router=http://192.168.1.1,google=https://dns.google,cloudflare=https://1.1.1.1
#
# Si dejas MONITOR_SERVICES vacio o lo comentas, el monitor
# detectara automaticamente tu gateway local y usara los
# DNS publicos como fallback (Cloudflare + Google).
# -----------------------------------------------------------
# MONITOR_SERVICES=example=https://example.com,jsonplaceholder=https://jsonplaceholder.typicode.com

# -----------------------------------------------------------
# Tiempo maximo de espera (milisegundos) por cada peticion HTTP
# -----------------------------------------------------------
# Un valor bajo (5000ms) evita que un servicio remoto caido
# bloquee la API durante mucho tiempo (patron fail-fast).
# Aumenta a 10000 si tienes servicios en redes lentas.
# -----------------------------------------------------------
REQUEST_TIMEOUT_MS=5000

# -----------------------------------------------------------
# Numero de sondas (pings HTTP) por servicio
# -----------------------------------------------------------
# Con 5 sondas calculamos latencia promedio, minima y maxima.
# Valores mas altos dan mas precision pero tardan mas en cada
# peticion a /api/metrics. No superar 20.
# -----------------------------------------------------------
PROBES=5
