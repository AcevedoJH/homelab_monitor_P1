---
// src/pages/index.astro
// ============================================================================
// Página principal: compone Header + ServiceGrid.
// Con output: 'static', el HTML inicial se genera en build/dev sin datos.
// El script liveMetrics.js (client:visible) hace polling y hidrata el grid.
// ============================================================================

import BaseLayout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import AddServiceForm from '../components/AddServiceForm.astro';
import type { SummaryMetrics } from '../types/index';

// Resumen inicial vacío (se actualiza vía JS cliente)
const emptySummary: SummaryMetrics = { total: 0, up: 0, degraded: 0, down: 0, availability: 0, avgLatencyMs: null };
const lastUpdated = new Date().toISOString();
---

<BaseLayout title="Homelab Monitor" description="Dashboard de monitorización de servicios en tiempo real">
  <!-- Header con resumen global y controles (inicial vacío) -->
  <Header summary={emptySummary} lastUpdated={lastUpdated} isLoading={true} />

  <!-- Formulario para agregar servicios desde la interfaz (manejado en liveMetrics.js) -->
  <AddServiceForm />

  <!-- Grid de servicios (inicialmente vacío, se hidrata vía liveMetrics.js) -->
  <ServiceGrid services={[]} isLoading={true} />

  <!-- Script de polling cliente: se ejecuta en el navegador y hace fetch a
       /api/metrics según el intervalo configurado (default 30s).
       is:inline = Astro emite el tag tal cual (sin bundlear): apunta a un
       archivo de public/ (scripts/liveMetrics.js). Con client:load el build
       estático DESCARTABA el tag y el polling nunca corría. -->
  <script is:inline src="/scripts/liveMetrics.js"></script>
</BaseLayout>