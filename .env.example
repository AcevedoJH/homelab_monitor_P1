# ============================================================================
#  .env.example — Variables para docker compose (raíz del repo)
# ----------------------------------------------------------------------------
#  Cómo usar:
#    1. Copia a ".env" en la raíz:   cp .env.example .env
#    2. Ajusta lo que necesites (o deja los defaults).
#    3. Arranca todo con:            docker compose up -d --build
#
#  IMPORTANTE: docker compose lee automáticamente este archivo (`.env`) para
#  interpolar las variables ${...} del docker-compose.yml. Las variables que
#  se pasan al BACKEND (MONITOR_SERVICES, etc.) se inyectan como variables de
#  entorno del contenedor; no es necesario tocar backend/.env.
# ============================================================================

# ---------------------------------------------------------------------------
# Puerto publicado hacia el host (única puerta de entrada web).
# El frontend (nginx) escuchará en http://<host>:4321 y servirá la app.
# NOTA: usa 4321 porque es la ruta configurada en Cloudflare Tunnel
# (homelab-monitor.acevedojavier.dev -> localhost:4321).
# ---------------------------------------------------------------------------
FRONTEND_PORT=4321

# ---------------------------------------------------------------------------
# Servicios estáticos a monitorizar (se inyectan en el contenedor backend).
# Formato: lista separada por comas de "nombre=url".
#   Ejemplo:
#     MONITOR_SERVICES=mi-router=http://192.168.1.1,google=https://dns.google,cloudflare=https://1.1.1.1
#   PRIVACIDAD: si se deja VACÍO, el backend detecta automáticamente el GATEWAY
#   local del servidor (tu router 192.168.x.1) y lo expone como métrica a
#   cualquiera que abra la app. Por eso aquí el default es SOLO servicios
#   públicos (DNS de Google + Cloudflare) y NO se incluye el gateway.
#   Si necesitas vigilar tu router, añádelo explícitamente en TU `.env`, p. ej.
#     MONITOR_SERVICES=router=http://192.168.1.1,google=https://dns.google,cloudflare=https://1.1.1.1
# ---------------------------------------------------------------------------
MONITOR_SERVICES=google=https://dns.google,cloudflare=https://1.1.1.1

# ---------------------------------------------------------------------------
# Timeout (ms) por petición HTTP del backend a los servicios monitorizados.
# ---------------------------------------------------------------------------
REQUEST_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Nº de sondas (pings HTTP) por servicio (para avg/min/max y disponibilidad).
# ---------------------------------------------------------------------------
PROBES=5

# ---------------------------------------------------------------------------
# Build arg del frontend (opcional). El frontend actual usa ruta relativa
# /api (API_BASE en liveMetrics.js) y NO requiere variables en build; dejar
# vacío. Si algún día necesitas inyectar import.meta.env.PUBLIC_* durante la
# compilación, define aquí el valor y se pasará como build arg al Dockerfile.
# ---------------------------------------------------------------------------
PUBLIC_API_BASE=
